`verilator_config

lint_off -rule PINCONNECTEMPTY
lint_off -rule UNUSEDPARAM -file "*/*_csr_pkg.sv" -match "*"
lint_off -rule MULTIDRIVEN -file "*/*_csr.sv" -match "*"
lint_off -rule GENUNNAMED -file "*/*_csr.sv" -match "*"
lint_off -rule UNUSEDPARAM -file "*/openenoc_full_endpoint_pkg.sv" -match "*"

lint_off -rule DECLFILENAME -file "*/picorv32.v" -match "*"
lint_off -rule GENUNNAMED   -file "*/picorv32.v" -match "*"
lint_off -rule BLKSEQ       -file "*/picorv32.v" -match "*"

lint_off -rule GENUNNAMED  -file "*/taxi_axil_*.sv" -match "*"
lint_off -rule UNUSEDPARAM -file "*/taxi_axil_*.sv" -match "*"
lint_off -rule PROCASSINIT -file "*/taxi_axil_*.sv" -match "*"

lint_off -rule UNUSEDPARAM  -file "*/taxi_axis_*.sv" -match "*"
lint_off -rule GENUNNAMED   -file "*/taxi_axis_*.sv" -match "*"
lint_off -rule PROCASSINIT  -file "*/taxi_axis_*.sv" -match "*"
lint_off -rule SYNCASYNCNET -file "*/taxi_axis_*.sv" -match "*"
lint_off -rule BLKSEQ -file "*/taxi_axis_*.sv" -match "*"

lint_off -rule GENUNNAMED  -file "*/taxi_arbiter.sv" -match "*"
lint_off -rule PROCASSINIT -file "*/taxi_arbiter.sv" -match "*"
lint_off -rule GENUNNAMED  -file "*/taxi_penc.sv" -match "*"

lint_off -rule PROCASSINIT  -file "*/taxi_sync_*.sv" -match "*"
