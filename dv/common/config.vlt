`verilator_config

lint_off -rule PINCONNECTEMPTY
lint_off -rule UNUSEDPARAM -file "*/*_csr_pkg.sv" -match "*"
lint_off -rule MULTIDRIVEN -file "*/*_csr.sv" -match "*"
lint_off -rule GENUNNAMED -file "*/*_csr.sv" -match "*"
lint_off -rule UNUSEDPARAM -file "*/openenoc_endpoint_full_pkg.sv" -match "*"
lint_off -rule UNUSEDPARAM -file "*/openenoc_dma_transfer_if.sv" -match "*"
lint_off -rule UNUSEDPARAM -file "*/openenoc_irq_event_if.sv" -match "*"
lint_off -rule UNUSEDPARAM -file "*/openenoc_peer_lookup_if.sv" -match "*"

lint_off -rule DECLFILENAME -file "*/picorv32.v" -match "*"
lint_off -rule GENUNNAMED   -file "*/picorv32.v" -match "*"
lint_off -rule BLKSEQ       -file "*/picorv32.v" -match "*"

lint_off -rule UNUSEDPARAM  -file "*/taxi_*.sv" -match "*"
lint_off -rule GENUNNAMED   -file "*/taxi_*.sv" -match "*"
lint_off -rule PROCASSINIT  -file "*/taxi_*.sv" -match "*"
lint_off -rule SYNCASYNCNET -file "*/taxi_*.sv" -match "*"
lint_off -rule BLKSEQ -file "*/taxi_*.sv" -match "*"
